{
  "name": "kiro-usage-mcp",
  "version": "0.1.0",
  "description": "MCP server that reports Kiro credit usage, read from kiro-cli /usage",
  "license": "MIT",
  "author": "Karel FAILLE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaffe-fr/kiro-usage-mcp.git"
  },
  "homepage": "https://github.com/shaffe-fr/kiro-usage-mcp#readme",
  "bugs": "https://github.com/shaffe-fr/kiro-usage-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kiro",
    "kiro-cli",
    "usage",
    "credits"
  ],
  "type": "module",
  "bin": {
    "kiro-usage-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/parse.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
